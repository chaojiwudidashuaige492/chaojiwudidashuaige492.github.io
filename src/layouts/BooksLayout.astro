---
import BaseLayout from './BaseLayout.astro';
import TreeNav from '../components/TreeNav.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import type { TreeNode } from '../utils/tree';

interface Props {
  title: string;
  description?: string;
  tree: TreeNode[];
  currentSlug: string;
}

const { title, description, tree, currentSlug } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="books-layout">
    <!-- Mobile sidebar toggle -->
    <button class="sidebar-toggle" type="button" aria-label="显示目录" aria-expanded="false">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
      <span>目录</span>
    </button>

    <!-- Sidebar overlay (mobile) -->
    <div class="sidebar-overlay" hidden></div>

    <!-- Left sidebar -->
    <aside class="sidebar">
      <div class="sidebar-header">
        <span class="sidebar-title">目录</span>
        <button class="sidebar-close" type="button" aria-label="关闭目录">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>
      </div>
      <TreeNav tree={tree} currentSlug={currentSlug} />
    </aside>

    <!-- Main content -->
    <article class="content">
      <Breadcrumbs slug={currentSlug} title={title} />
      <div class="prose">
        <slot />
      </div>
    </article>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    const toggle = document.querySelector('.sidebar-toggle');
    const sidebar = document.querySelector('.sidebar');
    const overlay = document.querySelector('.sidebar-overlay');
    const close = document.querySelector('.sidebar-close');
    if (!toggle || !sidebar || !overlay || !close) return;

    function open() {
      sidebar.classList.add('open');
      overlay.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
    }

    function shut() {
      sidebar.classList.remove('open');
      overlay.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
    }

    toggle.addEventListener('click', open);
    overlay.addEventListener('click', shut);
    close.addEventListener('click', shut);
  })();
</script>

<style>
  .books-layout {
    display: grid;
    grid-template-columns: var(--sidebar-width) 1fr;
    max-width: 1200px;
    margin: 0 auto;
    min-height: calc(100dvh - var(--navbar-height));
  }

  /* Sidebar */
  .sidebar {
    border-right: 1px solid var(--color-border);
    padding: 0 var(--space-4);
  }

  .sidebar-header {
    display: none;
  }

  .sidebar-overlay {
    display: none;
  }

  .sidebar-toggle {
    display: none;
  }

  /* Content */
  .content {
    padding: var(--space-8) var(--space-8) var(--space-16);
    max-width: var(--content-max-width);
    width: 100%;
  }

  /* Prose — markdown rendered content */
  .prose {
    margin-top: var(--space-6);
  }

  .prose :global(h1) {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-6);
    line-height: 1.3;
  }

  .prose :global(h2) {
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-top: var(--space-8);
    margin-bottom: var(--space-4);
    line-height: 1.4;
  }

  .prose :global(h3) {
    font-size: 1.125rem;
    font-weight: 600;
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
  }

  .prose :global(p) {
    margin-bottom: var(--space-4);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: var(--space-4);
    padding-left: var(--space-6);
  }

  .prose :global(li) {
    margin-bottom: var(--space-2);
  }

  .prose :global(pre) {
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    overflow-x: auto;
    margin-bottom: var(--space-4);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
  }

  .prose :global(:not(pre) > code) {
    background: var(--color-bg-subtle);
    padding: 0.125em 0.375em;
    border-radius: var(--radius-sm);
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding-left: var(--space-4);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
  }

  .prose :global(strong) {
    font-weight: 600;
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: var(--space-8) 0;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .books-layout {
      grid-template-columns: 1fr;
    }

    .sidebar {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: 280px;
      z-index: 200;
      background: var(--glass-bg);
      backdrop-filter: var(--glass-blur);
      -webkit-backdrop-filter: var(--glass-blur);
      border-right: 0.5px solid var(--glass-border);
      box-shadow: var(--shadow-lg);
      transform: translateX(-100%);
      transition: transform var(--transition-smooth);
      overflow-y: auto;
      padding: 0 var(--space-4);
    }

    .sidebar.open {
      transform: translateX(0);
    }

    .sidebar-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: var(--space-4) var(--space-3);
      border-bottom: 1px solid var(--color-border);
    }

    .sidebar-title {
      font-weight: 600;
      font-size: 0.875rem;
    }

    .sidebar-close {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2rem;
      height: 2rem;
      border: none;
      background: none;
      color: var(--color-text);
      cursor: pointer;
      border-radius: var(--radius-sm);
    }

    .sidebar-overlay:not([hidden]) {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 199;
      background: rgba(0, 0, 0, 0.4);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
    }

    .sidebar-toggle {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      margin: var(--space-4) var(--space-6) 0;
      padding: var(--space-2) var(--space-3);
      background: var(--glass-bg);
      backdrop-filter: var(--glass-blur);
      -webkit-backdrop-filter: var(--glass-blur);
      border: 0.5px solid var(--glass-border);
      border-radius: var(--radius-md);
      color: var(--color-text-secondary);
      font-size: 0.8125rem;
      cursor: pointer;
      box-shadow: var(--shadow-xs);
      transition: box-shadow var(--transition-fast),
                  transform var(--transition-fast),
                  color var(--transition-fast);
    }

    .sidebar-toggle:hover {
      box-shadow: var(--shadow-sm);
      transform: translateY(-1px);
      color: var(--color-text);
    }

    .content {
      padding: var(--space-6) var(--space-6) var(--space-16);
    }
  }
</style>
