---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="首页">
  <main class="home">
    <section class="hero">
      <div class="hero-card">
        <h1 class="hero-title">Welcome</h1>
        <p class="hero-subtitle">技术笔记与学习记录</p>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .home {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100dvh - var(--navbar-height));
    background: radial-gradient(
      ellipse 80% 60% at 50% 0%,
      color-mix(in srgb, var(--color-accent) 4%, transparent),
      transparent 70%
    );
  }

  .hero {
    text-align: center;
    padding: var(--space-16) var(--space-6);
  }

  .hero-card {
    display: inline-block;
    padding: var(--space-12) var(--space-16);
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border: 0.5px solid var(--glass-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    animation: fade-up 700ms cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
  }

  .hero-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-3);
    line-height: 1.1;
    background: linear-gradient(
      135deg,
      var(--color-text) 0%,
      var(--color-accent) 60%,
      #8b5cf6 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: fade-up 700ms cubic-bezier(0.25, 0.46, 0.45, 0.94) 80ms both;
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--color-text-secondary);
    animation: fade-up 700ms cubic-bezier(0.25, 0.46, 0.45, 0.94) 160ms both;
  }

  @media (max-width: 480px) {
    .hero-card {
      padding: var(--space-8) var(--space-6);
    }
  }
</style>
